# Registry Database
REGISTRY_CELERY_BEAT_DB_USERNAME="postgres"
REGISTRY_CELERY_BEAT_DB_PASSWORD="password"
REGISTRY_CELERY_BEAT_DB_HOSTNAME="localhost"
REGISTRY_CELERY_BEAT_DB_PORT=5432
REGISTRY_CELERY_BEAT_DB_DBNAME="registrydb"

# Celery Configuration
REGISTRY_CELERY_BEAT_CELERY_BROKER_URL="redis://localhost:6379/0"
REGISTRY_CELERY_BEAT_CELERY_BACKEND_URL="redis://localhost:6379/0"
REGISTRY_CELERY_BEAT_WORKER_QUEUE="registry_worker_queue"

REGISTRY_CELERY_BEAT_BATCH_SIZE=2000
REGISTRY_CELERY_BEAT_NO_OF_TASKS_TO_PROCESS=4

# Beat Producer Frequencies (remove to use default)
REGISTRY_CELERY_BEAT_DATA_TRANSFORMATION_BEAT_PRODUCER_FREQUENCY=10
REGISTRY_CELERY_BEAT_INGEST_DATA_BEAT_PRODUCER_FREQUENCY=10
REGISTRY_CELERY_BEAT_INGEST_DATA_CLASSIFICATION_BEAT_PRODUCER_FREQUENCY=10
REGISTRY_CELERY_BEAT_OUTGEST_DATA_PUBLISH_BEAT_PRODUCER_FREQUENCY=10
REGISTRY_CELERY_BEAT_OUTGEST_TOPIC_REGISTER_BEAT_PRODUCER_FREQUENCY=10
REGISTRY_CELERY_BEAT_DEDUPLICATION_BEAT_PRODUCER_FREQUENCY=30

# Master Data Database 
REGISTRY_CELERY_WORKERS_MASTER_DATA_DB_DRIVER="postgresql+asyncpg"
REGISTRY_CELERY_WORKERS_MASTER_DATA_DB_USERNAME="postgres"
REGISTRY_CELERY_WORKERS_MASTER_DATA_DB_PASSWORD="password"
REGISTRY_CELERY_WORKERS_MASTER_DATA_DB_HOSTNAME="localhost"
REGISTRY_CELERY_WORKERS_MASTER_DATA_DB_PORT=5432
REGISTRY_CELERY_WORKERS_MASTER_DATA_DB_DBNAME="masterdatadb"